      "grain": "aggregate",
      "aggregation": "compare mean(balance) by job",
      "snapshot": "fixture:6fd6aefae0385fe96f9884c3154048e19641fc9ae55f872378551b8c1e268c25",
      "query": "WITH baseline_agg AS (SELECT \"job\", AVG(\"balance\") AS \"baseline_mean_balance\" FROM baseline_data GROUP BY \"job\"), cohort_agg AS (SELECT \"job\", AVG(\"balance\") AS \"cohort_mean_balance\" FROM cohort_data GROUP BY \"job\") SELECT COALESCE(b.\"job\", c.\"job\") AS \"job\", b.\"baseline_mean_balance\", c.\"cohort_mean_balance\", c.\"cohort_mean_balance\" - b.\"baseline_mean_balance\" AS difference, CASE WHEN b.\"baseline_mean_balance\" IS NOT NULL AND b.\"baseline_mean_balance\" <> 0 THEN 100.0 * (c.\"cohort_mean_balance\" - b.\"baseline_mean_balance\") / ABS(b.\"baseline_mean_balance\") ELSE NULL END AS percent_change FROM baseline_agg AS b FULL OUTER JOIN cohort_agg AS c ON b.\"job\" = c.\"job\" ORDER BY CAST(COALESCE(b.\"job\", c.\"job\") AS VARCHAR) ASC",
