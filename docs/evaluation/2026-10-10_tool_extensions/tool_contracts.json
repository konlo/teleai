[
  {
    "name": "get_analysis_tool_contract",
    "description": "이름으로 현재 실제 등록 도구의 입력/출력 계약을 정확히 확인합니다. 실행하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
    "name": "plan_analysis_execution",
    "description": "현재 목표의 출처·조건을 유지하며 보유 데이터 재사용/DB 집계/컬럼 배치 적재 계획과 로컬 메모리 추정량을 반환합니다. 조회·비용 추정이 없으면 null이며 실행하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "operation": {
          "type": "string",
          "enum": [
            "rows",
            "aggregate",
            "chart"
          ]
        }
      },
      "required": [
        "source",
        "columns"
      ]
    }
  },
  {
    "name": "inspect_execution_status",
    "description": "현재 대화의 조회 장부 상태와 완료 receipt를 확인합니다. unknown/submitting은 재조회하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": []
    }
  },
  {
    "name": "cancel_database_query",
    "description": "현재 대화에 속한 실행 중 조회만 DB 드라이버로 취소 요청합니다. 취소 요청과 실제 종료는 구분하며 재시작 후 연결이 없는 unknown 조회를 재제출하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "request_id"
      ]
    }
  },
  {
    "name": "inspect_backend_health",
    "description": "현재 연결의 SELECT 1 검사로 모델과 DB 장애를 분리합니다. 사용자 데이터는 적재하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  },
  {
    "name": "diagnose_analysis_failure",
    "description": "현재 실행의 실패 단계·남은 목표·실제 데이터 핸들을 읽습니다. 원본/조건/권한은 변경하지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  },
  {
    "name": "inspect_analysis_plan",
    "description": "현재 요청의 영속 작업별 범위·완료 근거·의존성 계획을 읽습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  },
  {
    "name": "update_analysis_dependencies",
    "description": "현재 계획의 미완료 작업 의존성을 지정합니다. 범위·옵션·완료 상태를 변경할 수 없으며 순환 의존성을 거절합니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edges": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "depends_on": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "required": [
              "task_id",
              "depends_on"
            ]
          }
        }
      },
      "required": [
        "edges"
      ]
    }
  },
  {
    "name": "execute_analysis_python",
    "description": "제한된 pandas/numpy 코드를 별도 워커의 작업본에서 수행합니다. df/pd/np가 이미 제공됩니다. import/파일/네트워크/함수/루프/private/inplace는 금지입니다. 작업본 df[컬럼]=값 또는 assign으로 새 컬럼을 만들 수 있으며 저장된 원본은 바뀌지 않습니다. result DataFrame을 지정하거나 마지막 줄에서 한 DataFrame만 print하세요. rolling/groupby/agg/quantile/산술 등을 지원합니다. 원래 목표·범위를 유지하세요.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "dataset_id",
        "columns",
        "code"
      ]
    }
  },
  {
    "name": "render_advanced_eda",
    "description": "관측된 수치 컬럼 2~6개로 correlation_heatmap/scatter_matrix/distribution_panels PNG와 계산 digest를 만듭니다. max_points는 산점도 표본 상한이며 heatmap/분포 계산은 전체 보유 행을 사용합니다. 표본 산점도는 명시하며 원본·조건을 보존합니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "correlation_heatmap",
            "scatter_matrix",
            "distribution_panels"
          ]
        },
        "max_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": [
        "dataset_id",
        "columns",
        "kind"
      ]
    }
  },
  {
    "name": "export_analysis_result",
    "description": "검증된 저장 dataset/chart를 CSV/Parquet/PNG와 출처·조건·범위 manifest ZIP으로 저장합니다. 실제 dataset_id 또는 chart_id 중 하나가 반드시 필요합니다. dataset columns는 요청한 출력 컬럼이며 생략하면 현재 목표의 명시 컬럼 또는 전체 저장 컬럼을 사용합니다. 임의 파일/URL은 받지 않습니다.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chart_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "parquet",
            "png"
          ]
        }
      },
      "required": [
        "format"
      ],
      "oneOf": [
        {
          "required": [
            "dataset_id"
          ],
          "not": {
            "required": [
              "chart_id"
            ]
          }
        },
        {
          "required": [
            "chart_id"
          ],
          "not": {
            "required": [
              "dataset_id"
            ]
          }
        }
      ]
    }
  }
]
