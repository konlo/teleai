[Unit]
Description=Telly private single-user analysis agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telly
Group=telly
WorkingDirectory=/opt/telly/current
EnvironmentFile=/etc/telly/telly.env
ExecStartPre=/opt/telly/current/.venv/bin/python scripts/deployment_preflight.py --profile private-single-user
ExecStart=/opt/telly/current/.venv/bin/python -m streamlit run main.py --server.address=127.0.0.1 --server.port=8502 --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/telly
UMask=0077

[Install]
WantedBy=multi-user.target
