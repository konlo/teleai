# Configuration reference: preserve an existing .env and its credentials.
# For a new environment, copy this template or inject values from a secret manager.
# Home development model. Data backend selection is separate from model selection.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:e4b
# Optional local Ollama model dedicated to goal interpretation/review.
# Empty uses OLLAMA_MODEL; install/qualify the chosen model before setting it.
TELLY_GOAL_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Company service: Azure OpenAI configuration names used by core/llm.py.
# Intended model provider: LLM_PROVIDER=azure; data backend: databricks.
# IMPORTANT: the current persistent agent factory/UI does not yet support Azure.
# These entries document the existing configuration contract, not a working switch.
# Use the existing service values; never put real credentials in this template.
AZURE_OPENAI_API_KEY=
# Azure resource endpoint, not a deployment-specific chat/completions URL.
AZURE_OPENAI_ENDPOINT=
# The Azure deployment name; it may differ from the base model name.
AZURE_OPENAI_DEPLOYMENT=
# The API version supported by the existing Azure service configuration.
AZURE_OPENAI_API_VERSION=

# Databricks is the SQL/data service, independent of Azure/Ollama model APIs.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Agent data backend. MySQL is for local evaluation; release remains Databricks.
TELLY_DATA_BACKEND=databricks
TELLY_MYSQL_DATABASE=teleai_default
TELLY_MYSQL_OPTION_FILE=.telly_runtime/mysql_eval/reader.cnf
# Server execution limit; large exact GROUP BY may need a longer scan (1..600).
# This does not alter Databricks settings or promise the 180-second turn SLO.
TELLY_MYSQL_QUERY_TIMEOUT_SECONDS=120

# Use a code-independent persistent volume in a deployment environment.
# Windows example: C:/telly/v1. Keep the existing host's storage path unchanged.
TELLY_V1_STORAGE=/var/lib/telly/v1

# Required only for the private-single-user deployment profile.
TELLY_EXTERNAL_ACCESS_CONTROL=false
TELLY_ACCESS_MODE=ssh-tunnel

TELLY_MAX_REMOTE_ROWS=100000
# Only the verified two-axis exact-coordinate frequency query uses this cap.
# Generic raw/aggregate SQL keeps TELLY_MAX_REMOTE_ROWS; byte/disk guards apply.
TELLY_MAX_SCATTER_COORDINATES=250000
TELLY_MAX_DATASET_COLUMNS=256
TELLY_MAX_DATASET_BYTES=536870912
TELLY_MAX_JOIN_ROWS=100000
TELLY_MAX_JOIN_EXPANSION_RATIO=5.0
TELLY_FRAME_CACHE_BYTES=67108864
TELLY_SCOPE_DISK_QUOTA_BYTES=2147483648
TELLY_RETENTION_DAYS=30
TELLY_MODEL_TIMEOUT_SECONDS=60
TELLY_TURN_SLO_SECONDS=180

# Initial one-process capacity gate. Override after measuring the deployment host.
TELLY_DETERMINISTIC_P95_SECONDS=1
TELLY_CAPACITY_MIN_REQUESTS=20
TELLY_CAPACITY_MIN_WORKERS=4
TELLY_MEMORY_LIMIT_BYTES=1073741824
TELLY_RSS_WARNING_BYTES=805306368
TELLY_RSS_CRITICAL_BYTES=939524096

# Optional manual approval mode; default is autonomous read-only queries.
TELLY_REQUIRE_REMOTE_APPROVAL=false
