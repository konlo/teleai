# Azure OpenAI LLM + Databricks SQL database configuration reference.
# Keep the existing .env unchanged. Transfer only needed settings manually.
# This file is a template; the app automatically loads .env, not this filename.
# Never commit real API keys or tokens into this example.
# The persistent agent supports Azure. Actual API access and model/tool support
# must still be verified on your service host with its existing credentials.

# LLM provider: Azure OpenAI, independent of the database backend.
LLM_PROVIDER=azure
TELLY_ANALYSIS_MODEL_PROVIDER=azure
# Fill with the existing Azure service values.
AZURE_OPENAI_API_KEY=
# Resource endpoint, e.g. https://YOUR-RESOURCE.openai.azure.com/
# Do not use a deployment-specific chat/completions URL here.
AZURE_OPENAI_ENDPOINT=
# Azure deployment name, which may differ from the underlying model name.
AZURE_OPENAI_DEPLOYMENT=
# Preserve the API version supported by your existing Azure configuration.
AZURE_OPENAI_API_VERSION=
# Legacy chat deployments normally use max_tokens. Set max_completion_tokens
# if your reasoning deployment requires that parameter. No model is renamed.
TELLY_AZURE_TOKEN_PARAMETER=max_tokens

# Database provider: Databricks SQL. No MySQL or Ollama settings are needed.
TELLY_DATA_BACKEND=databricks
# Workspace hostname, e.g. adb-YOUR-WORKSPACE.azuredatabricks.net
# This is separate from AZURE_OPENAI_ENDPOINT.
DATABRICKS_HOST=
# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/YOUR-WAREHOUSE-ID
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Discovery starting point. Use your workspace's actual catalog and schema.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
# Optional settings preserved for environments with separate Azure Blob access.
# Current SQL queries do not read these two values. Blob loading is not wired;
# setting them does not enable it or replace Databricks authentication.
AZURE_STORAGE_ACCOUNT=
BLOB_CONNECTION_STR=
# Autonomous read-only database queries; no manual query approval cards.
TELLY_REQUIRE_REMOTE_APPROVAL=false

# Persistent storage: Windows example. Keep the current host's existing path
# to preserve conversations and loaded datasets. The service user needs access.
TELLY_V1_STORAGE=C:/telly/v1

# Model timeout / turn target. Timeout increases do not fix provider selection.
TELLY_MODEL_TIMEOUT_SECONDS=60
TELLY_TURN_SLO_SECONDS=180

# Loading, caching and disk limits; tune after measuring the deployment host.
TELLY_MAX_REMOTE_ROWS=100000
TELLY_MAX_SCATTER_COORDINATES=250000
TELLY_MAX_DATASET_COLUMNS=256
TELLY_MAX_DATASET_BYTES=536870912
TELLY_MAX_JOIN_ROWS=100000
TELLY_MAX_JOIN_EXPANSION_RATIO=5.0
TELLY_FRAME_CACHE_BYTES=67108864
TELLY_SCOPE_DISK_QUOTA_BYTES=2147483648
TELLY_RETENTION_DAYS=30
